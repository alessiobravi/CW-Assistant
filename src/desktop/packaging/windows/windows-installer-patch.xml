<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <CPackWiXFragment Id="#PRODUCT">
    <!--
      Keep the finish-page launch choice visible but initially unchecked. The
      CloseApplication property below is the only path that selects it by
      default, after an upgrade installer actually found a running instance.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch CW Assistant" />
    <Property Id="WixShellExecTarget"
              Value="[INSTALL_ROOT]bin\cw-assistant-desktop.exe" />

    <CustomAction Id="CwaLaunchApplication"
                  BinaryKey="WixCA_x64"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  Return="ignore" />
    <CustomAction Id="CwaDefaultLaunchAfterClosingApplication"
                  Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX"
                  Value="1" />
    <CustomAction Id="CwaBeginRunningApplicationDetection"
                  Property="CwaDetectionOnly"
                  Value="1" />
    <CustomAction Id="CwaDetectRunningApplication"
                  BinaryKey="WixCA_x64"
                  DllEntry="WixCloseApplications"
                  Execute="immediate"
                  Return="check" />

    <InstallUISequence>
      <!--
        Detect in the client/UI session so CWA_APP_WAS_RUNNING remains
        available to ExitDialog. CwaDetectionOnly is intentionally private:
        Windows Installer does not copy it to the elevated execute session.
      -->
      <Custom Action="CwaBeginRunningApplicationDetection"
              Before="CwaDetectRunningApplication">
        WIX_UPGRADE_DETECTED
      </Custom>
      <Custom Action="CwaDetectRunningApplication"
              Before="ExecuteAction">
        WIX_UPGRADE_DETECTED
      </Custom>
      <Custom Action="CwaDefaultLaunchAfterClosingApplication"
              After="ExecuteAction">
        CWA_APP_WAS_RUNNING AND NOT REMOVE~=&quot;ALL&quot;
      </Custom>
    </InstallUISequence>

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="CwaLaunchApplication">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT REMOVE~=&quot;ALL&quot;
      </Publish>
    </UI>

    <!--
      CPack's MajorUpgrade authoring sets WIX_UPGRADE_DETECTED. The first row
      only detects the process in the UI session. The standard execute-sequence
      WixCloseApplications action processes the second row, requests a graceful
      close, and only terminates after the bounded wait expires.
    -->
    <util:CloseApplication Id="CwaDetectRunningApplicationDuringUpgrade"
                           Target="cw-assistant-desktop.exe"
                           Description="CW Assistant must close before the update can continue."
                           Property="CWA_APP_WAS_RUNNING"
                           Sequence="1"
                           RebootPrompt="no">
      WIX_UPGRADE_DETECTED AND CwaDetectionOnly
    </util:CloseApplication>
    <util:CloseApplication Id="CwaCloseRunningApplicationDuringUpgrade"
                           Target="cw-assistant-desktop.exe"
                           Description="CW Assistant must close before the update can continue."
                           Sequence="2"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           Timeout="15"
                           TerminateProcess="1"
                           RebootPrompt="no">
      WIX_UPGRADE_DETECTED AND NOT CwaDetectionOnly
    </util:CloseApplication>
  </CPackWiXFragment>
</CPackWiXPatch>
