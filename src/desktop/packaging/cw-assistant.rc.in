#include <windows.h>

IDI_APPLICATION_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/cw-assistant.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@CWA_PACKAGE_REVISION@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@CWA_PACKAGE_REVISION@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Alessio Bravi\0"
      VALUE "FileDescription", "CW Assistant\0"
      VALUE "FileVersion", "@CWA_BUILD_VERSION@\0"
      VALUE "InternalName", "cw-assistant-desktop\0"
      VALUE "LegalCopyright", "GPL-3.0-or-later\0"
      VALUE "OriginalFilename", "cw-assistant-desktop.exe\0"
      VALUE "ProductName", "CW Assistant\0"
      VALUE "ProductVersion", "@CWA_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
