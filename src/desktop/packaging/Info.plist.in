<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>English</string>
  <key>CFBundleDisplayName</key>
  <string>@CWA_MACOS_BUNDLE_NAME@</string>
  <key>CFBundleExecutable</key>
  <string>@CWA_MACOS_BUNDLE_EXECUTABLE@</string>
  <key>CFBundleIconFile</key>
  <string>@CWA_MACOS_BUNDLE_ICON@</string>
  <key>CFBundleIdentifier</key>
  <string>@CWA_MACOS_BUNDLE_IDENTIFIER@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>@CWA_MACOS_BUNDLE_NAME@</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@CWA_BUILD_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@CWA_BUILD_VERSION@</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>CW Assistant uses the selected audio input to receive and decode radio audio.</string>
</dict>
</plist>
